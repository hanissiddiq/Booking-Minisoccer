{ "compilerOptions": { "target": "ES2022", "lib": ["dom","esnext"], "jsx": "preserve", "module": "esnext",
  "moduleResolution": "bundler", "strict": false, "noEmit": true, "esModuleInterop": true, "skipLibCheck": true,
  "allowJs": true, "isolatedModules": true, "incremental": true, "resolveJsonModule": true,
  "plugins": [{ "name": "next" }], "paths": { "@/*": ["./*"] } },
  "include": ["next-env.d.ts","**/*.ts","**/*.tsx",".next/types/**/*.ts"], "exclude": ["node_modules"] }
